bp /w "(@ebx == 7 || @ebx == 8 || @ebx == 24) && @r13d == 0" OLMRadialBlur+0x5e6d ".echo === SAMPLE_TARGET_RETURN ===; .printf \"xy=(%u,%u) rdi_cell_after=%p\\n\", @ebx,@r13d,@rdi; r; dq @rdi L8; gc"

d}} stage=stored x=314 y=14 role=control address_match=1 output_addr=%p expected_output_addr=%p rgb16=%hu,%hu,%hu\\\\n\\\",@rbx,@$t3+(14*@$t4)+(314*8),wo(@rbx+2),wo(@rbx+4),wo(@rbx+6)} .else {.if (@esi==29 && @r12d==71 && @rbx==(@$t3+(71*@$t4)+(29*8))) {r @$t2=@$t2+1;.printf \\\"BLUR16_CAPTURE_STORED_RGB16 run_id={{RUN_ID}} ae_pid={{AE_PID}} module_base={{MODULE_BASE}} aex_sha256={{AEX_SHA256}} project_bpc={{PROJECT_BPC}} renderer={{RENDERER}} case_id={{CASE_ID}} witness_id={{CASE_VALUE:witness_id}} stage=stored x=29 y=71 role=capture address_match=1 output_addr=%p expected_output_addr=%p rgb16=%hu,%hu,%hu\\\\n\\\",@rbx,@$t3+(71*@$t4)+(29*8),wo(@rbx+2),wo(@rbx+4),wo(@rbx+6);.if (@$t1==1 && @$t2==1) {.detach;q}}};gc\";.echo BLUR16_TYPED_BREAKPOINTS_ARMED_AFTER_WORKER_ENTRY;gc} .else {gc}"

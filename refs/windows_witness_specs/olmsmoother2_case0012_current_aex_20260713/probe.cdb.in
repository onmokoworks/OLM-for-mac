bp {{ADDRESS:final_writer}} ".if (@$t0==1 && @$t1==1 && @$t2==1 && @$t3==1 && @$t4==1 && @$t5==1) {.printf \"S2_WRITER run_id={{RUN_ID}} ae_pid={{AE_PID}} module_base={{MODULE_BASE}} aex_sha256={{AEX_SHA256}} project_bpc={{PROJECT_BPC}} renderer={{RENDERER}} case_id={{CASE_ID}} witness_id={{CASE_VALUE:witness_id}} stage=final_writer hook_rva=3610 writer_site=OLMSmoother2+0x3610 rgba_u8=%u,%u,%u,%u rgba_float=%g,%g,%g,%g\\n\",by(@rsi),by(@rsi+1),by(@rsi+2),by(@rsi+3),@xmm0,@xmm1,@xmm2,@xmm3;.detach;q} .else {gc}"

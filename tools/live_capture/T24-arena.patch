+#[test]
+fn t24_data_arena_preserves_low_addresses_and_spills_without_overlap() {
+    let mut engine = test_engine(&[0xc3]);
+    // PARAMS_SETUP stores popup text above WORLD_DATA_END before rendering.
+    engine.unicorn.mem_map(POPUP_CHOICES_BASE, PAGE_SIZE, Prot::READ | Prot::WRITE).unwrap();
+    engine.write(POPUP_CHOICES_BASE, &[0x42]).unwrap();
+    assert_eq!(engine.allocate(13, 1).unwrap(), DATA_BASE);
+    assert_eq!(engine.allocate(8, 8).unwrap(), DATA_BASE + 16);
+    engine.write(DATA_BASE, &[0xa5; 13]).unwrap();
+    engine.next_data = HANDLE_DATA_BASE - 64;
+    assert_eq!(engine.allocate(64, 64).unwrap(), HANDLE_DATA_BASE - 64);
+    let spilled = engine.allocate(33_177_728, 64).unwrap();
+    assert_eq!(spilled, HOST_DATA_OVERFLOW_BASE);
+    let next = engine.allocate(32, 256).unwrap();
+    assert_eq!(next, (spilled + 33_177_728 + 255) & !255);
+    engine.write(spilled, &[0x5a; 16]).unwrap();
+    engine.write(spilled + 33_177_728 - 1, &[0x77]).unwrap();
+    engine.write(next, &[0x99; 32]).unwrap();
+    let mut old = [0; 13];
+    engine.read(DATA_BASE, &mut old).unwrap();
+    assert_eq!(old, [0xa5; 13]);
+    let mut popup = [0; 1];
+    engine.read(POPUP_CHOICES_BASE, &mut popup).unwrap();
+    assert_eq!(popup, [0x42]);
+    assert!(HOST_DATA_OVERFLOW_BASE >= POPUP_CHOICES_BASE + MAX_POPUP_CHOICE_PAGES * PAGE_SIZE);
+    let mut value = [0; 1];
+    engine.read(spilled + 33_177_728 - 1, &mut value).unwrap();
+    assert_eq!(value, [0x77]);
+    assert_eq!(HANDLE_DATA_BASE, 0x4400_0000);
+    assert_eq!(HANDLE_DATA_END, 0x5000_0000);
+    assert_eq!(HOST_PERSISTENT_BLOB_TOKEN, 0x5000_1000);
+    assert_eq!(PF_HANDLE_DATA_BASE, 0x1_0000_0000);
+    assert_eq!(WORLD_DATA_BASE, 0x3_0000_0000);
+    assert!(HOST_DATA_OVERFLOW_BASE >= WORLD_DATA_END);
+    assert!(HOST_DATA_OVERFLOW_BASE + HOST_DATA_OVERFLOW_SIZE <= CRT_HEAP_BASE);
+}
+
+#[test]
+fn t24_data_arena_capacity_failure_does_not_advance_cursor() {
+    let mut engine = test_engine(&[0xc3]);
+    engine.next_data = HANDLE_DATA_BASE;
+    assert!(matches!(engine.allocate(HOST_DATA_OVERFLOW_SIZE as usize + 1, 64), Err(GuestError::DataCapacity)));
+    assert_eq!(engine.next_data, HANDLE_DATA_BASE);
+    assert_eq!(engine.allocate(1, 64).unwrap(), HOST_DATA_OVERFLOW_BASE);
+    engine.next_data = HOST_DATA_OVERFLOW_BASE + HOST_DATA_OVERFLOW_SIZE - 8;
+    let before = engine.next_data;
+    assert!(matches!(engine.allocate(9, 1), Err(GuestError::DataCapacity)));
+    assert_eq!(engine.next_data, before);
+    assert!(matches!(engine.allocate(usize::MAX, 1), Err(GuestError::DataCapacity)));
+    assert_eq!(engine.next_data, before);
+    assert_eq!(engine.allocate(8, 1).unwrap(), before);
+}

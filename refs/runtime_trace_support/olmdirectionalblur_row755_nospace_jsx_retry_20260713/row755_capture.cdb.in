bu @$t0+0x38d0 "r @$t8=@$t8+1; r @$t7=poi(@rsp+0x38); .if (@$t8==1) { r @$t4=@rcx; r @$t5=@rdx; }; .if (@rcx < @$t4) { r @$t4=@rcx; }; .if (@rdx > @$t5) { r @$t5=@rdx; }; .if (@$t7 != @$t10) { r @$t13=1; }; .if (@rcx <= 0n755) { .if (@rdx > 0n755) { r @$t12=1; } }; .printf \"DBR_ROW_RANGE run_id=__RUN__ pid=%u call=%u start=%u end=%u params=%p\\n\", @$tpid, @$t8, @rcx, @rdx, @$t7; g"

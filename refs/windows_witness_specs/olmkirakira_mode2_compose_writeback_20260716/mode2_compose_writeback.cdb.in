.effmach amd64
.expr /s masm
sxi 80000003
.logopen /t "{{TRACE_PATH}}"
r @$t0=0
bp {{ADDRESS:mode2_return}} ".if (@$t0==0) {r @$t0=1;.printf \"KK_MODE2_RETURN run_id={{RUN_ID}} ae_pid={{AE_PID}} module_base={{MODULE_BASE}} aex_sha256={{AEX_SHA256}} project_bpc={{PROJECT_BPC}} renderer={{RENDERER}} case_id={{CASE_ID}} witness_id={{CASE_VALUE:witness_id}} stage=mode2_return target_rva=14ffd0 dispatch_slot=+0x10 threshold_f64=0.001 output_ptr=%p pre_clamp_rgba_f32=%g,%g,%g,%g post_clamp_rgba_f32=%g,%g,%g,%g clamp_count=4\\n\",@rdi,@xmm0,@xmm1,@xmm2,@xmm3,@xmm0,@xmm1,@xmm2,@xmm3);gc}"
bp {{ADDRESS:host_compose}} ".printf \"KK_HOST_COMPOSE run_id={{RUN_ID}} ae_pid={{AE_PID}} module_base={{MODULE_BASE}} aex_sha256={{AEX_SHA256}} project_bpc={{PROJECT_BPC}} renderer={{RENDERER}} case_id={{CASE_ID}} witness_id={{CASE_VALUE:witness_id}} stage=host_compose input_ptr=%p output_ptr=%p compose_formula=live_host_compose source_rgba_f32=%g,%g,%g,%g glow_rgba_f32=%g,%g,%g,%g typed_prewriteback_rgba_f32=%g,%g,%g,%g\\n\",@rcx,@rdx,@xmm0,@xmm1,@xmm2,@xmm3,@xmm4,@xmm5,@xmm6,@xmm7,@xmm0,@xmm1,@xmm2,@xmm3);gc"
bp {{ADDRESS:pf8_entry}} ".printf \"KK_PF8_ENTRY run_id={{RUN_ID}} ae_pid={{AE_PID}} module_base={{MODULE_BASE}} aex_sha256={{AEX_SHA256}} project_bpc={{PROJECT_BPC}} renderer={{RENDERER}} case_id={{CASE_ID}} witness_id={{CASE_VALUE:witness_id}} stage=pf8_entry entry_rva=230b90 input_scale=255 destination_addr=%p\\n\",@rcx; .printf \"KK_SELECTED_WRITER run_id={{RUN_ID}} ae_pid={{AE_PID}} module_base={{MODULE_BASE}} aex_sha256={{AEX_SHA256}} project_bpc={{PROJECT_BPC}} renderer={{RENDERER}} case_id={{CASE_ID}} witness_id={{CASE_VALUE:witness_id}} stage=selected_writer writer_family=PF8 entry_rva=230b90 input_scale=255 conversion=clamp_round_f32_to_u8 destination_addr=%p typed_prewriteback_rgba_f32=%g,%g,%g,%g\\n\",@rcx,@xmm0,@xmm1,@xmm2,@xmm3;gc"
bp {{ADDRESS:pf16_entry}} ".printf \"KK_PF16_ENTRY run_id={{RUN_ID}} ae_pid={{AE_PID}} module_base={{MODULE_BASE}} aex_sha256={{AEX_SHA256}} project_bpc={{PROJECT_BPC}} renderer={{RENDERER}} case_id={{CASE_ID}} witness_id={{CASE_VALUE:witness_id}} stage=pf16_entry entry_rva=230bd0 input_scale=65535 destination_addr=%p\\n\",@rcx; .printf \"KK_SELECTED_WRITER run_id={{RUN_ID}} ae_pid={{AE_PID}} module_base={{MODULE_BASE}} aex_sha256={{AEX_SHA256}} project_bpc={{PROJECT_BPC}} renderer={{RENDERER}} case_id={{CASE_ID}} witness_id={{CASE_VALUE:witness_id}} stage=selected_writer writer_family=PF16 entry_rva=230bd0 input_scale=65535 conversion=clamp_round_f32_to_u16 destination_addr=%p typed_prewriteback_rgba_f32=%g,%g,%g,%g\\n\",@rcx,@xmm0,@xmm1,@xmm2,@xmm3;gc"
bp {{ADDRESS:pf32_entry}} ".printf \"KK_PF32_ENTRY run_id={{RUN_ID}} ae_pid={{AE_PID}} module_base={{MODULE_BASE}} aex_sha256={{AEX_SHA256}} project_bpc={{PROJECT_BPC}} renderer={{RENDERER}} case_id={{CASE_ID}} witness_id={{CASE_VALUE:witness_id}} stage=pf32_entry entry_rva=230c20 input_scale=1 destination_addr=%p\\n\",@rcx; .printf \"KK_SELECTED_WRITER run_id={{RUN_ID}} ae_pid={{AE_PID}} module_base={{MODULE_BASE}} aex_sha256={{AEX_SHA256}} project_bpc={{PROJECT_BPC}} renderer={{RENDERER}} case_id={{CASE_ID}} witness_id={{CASE_VALUE:witness_id}} stage=selected_writer writer_family=PF32 entry_rva=230c20 input_scale=1 conversion=raw_f32_store destination_addr=%p typed_prewriteback_rgba_f32=%g,%g,%g,%g\\n\",@rcx,@xmm0,@xmm1,@xmm2,@xmm3;gc"
bp {{ADDRESS:pf8_store_after}} ".printf \"KK_STORE_AFTER run_id={{RUN_ID}} ae_pid={{AE_PID}} module_base={{MODULE_BASE}} aex_sha256={{AEX_SHA256}} project_bpc={{PROJECT_BPC}} renderer={{RENDERER}} case_id={{CASE_ID}} witness_id={{CASE_VALUE:witness_id}} stage=store_after writer_family=PF8 entry_rva=230b90 destination_addr=%p after_store_words=%08x,%08x,%08x,%08x store_width=8\\n\",@rcx,by(@rcx),by(@rcx+1),by(@rcx+2),by(@rcx+3);gc"
bp {{ADDRESS:pf16_store_after}} ".printf \"KK_STORE_AFTER run_id={{RUN_ID}} ae_pid={{AE_PID}} module_base={{MODULE_BASE}} aex_sha256={{AEX_SHA256}} project_bpc={{PROJECT_BPC}} renderer={{RENDERER}} case_id={{CASE_ID}} witness_id={{CASE_VALUE:witness_id}} stage=store_after writer_family=PF16 entry_rva=230bd0 destination_addr=%p after_store_words=%04x,%04x,%04x,%04x store_width=16\\n\",@rcx,wo(@rcx),wo(@rcx+2),wo(@rcx+4),wo(@rcx+6);gc"
bp {{ADDRESS:pf32_store_after}} ".printf \"KK_STORE_AFTER run_id={{RUN_ID}} ae_pid={{AE_PID}} module_base={{MODULE_BASE}} aex_sha256={{AEX_SHA256}} project_bpc={{PROJECT_BPC}} renderer={{RENDERER}} case_id={{CASE_ID}} witness_id={{CASE_VALUE:witness_id}} stage=store_after writer_family=PF32 entry_rva=230c20 destination_addr=%p after_store_words=%08x,%08x,%08x,%08x store_width=32\\n\",@rcx,dwo(@rcx),dwo(@rcx+4),dwo(@rcx+8),dwo(@rcx+12);gc"
.echo KK_MODE2_WRITEBACK_BREAKPOINTS_READY
g

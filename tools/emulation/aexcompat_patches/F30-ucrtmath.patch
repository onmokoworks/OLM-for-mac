+use std::{env, path::PathBuf, process::Command};
+fn main() {
+    let out = PathBuf::from(env::var_os("OUT_DIR").unwrap());
+    let arch = match env::var("CARGO_CFG_TARGET_ARCH").unwrap().as_str() {
+        "aarch64" => "arm64", "x86_64" => "x86_64", _ => panic!("unsupported architecture"),
+    };
+    let mut objects = Vec::new();
+    for name in ["expf", "atan2f", "powf", "tables"] {
+        let source = format!("ucrtmath/src/{name}.c");
+        let object = out.join(format!("{name}.o"));
+        assert!(Command::new("clang").args(["-arch", arch, "-std=c11", "-O2", "-ffp-contract=off", "-fno-fast-math", "-Iucrtmath/include", "-c", &source, "-o"]).arg(&object).status().unwrap().success());
+        objects.push(object);
+    }
+    assert!(Command::new("ar").arg("rcs").arg(out.join("libucrtmath.a")).args(objects).status().unwrap().success());
+    println!("cargo:rerun-if-changed=ucrtmath");
+    println!("cargo:rustc-link-search=native={}", out.display());
+    println!("cargo:rustc-link-lib=static=ucrtmath");
+}

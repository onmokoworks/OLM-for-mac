.effmach amd64
.expr /s masm
sxi e06d7363
.logopen /t "{{TRACE_PATH}}"
.echo WITNESS_META {{RUN_ID}} {{AE_PID}} {{MODULE_BASE}} {{AEX_SHA256}} {{PROJECT_BPC}} {{RENDERER}} {{CASE_ID}}
.echo WITNESS_FILTER dwo(@rbx+0x94)==3 dwo(@rbx+0xd0)==0x40263bec
r @$t0=0;r @$t1=0;r @$t2=0;r @$t6=0;r @$t7=0
bp {{ADDRESS:entry}} ".block {r @$t0=0;r @$t6=@edx;r @$t7=@r8;.if (@edx==907) {.if (@r8==222) {r @$t0=1}} .else {.if (@edx==395) {.if (@r8==477) {r @$t0=1}} .else {.if (@edx==1589) {.if (@r8==579) {r @$t0=1}} .else {.if (@edx==898) {.if (@r8==670) {r @$t0=1}}}}};.if (@$t0==1) {r @$t1=poi(@rsp+0x28);.printf \"OLMDG_LFS_ENTRY_%u_%u run_id={{RUN_ID}} ae_pid={{AE_PID}} module_base={{MODULE_BASE}} aex_sha256={{AEX_SHA256}} project_bpc={{PROJECT_BPC}} renderer={{RENDERER}} case_id={{CASE_ID}} witness_id={{CASE_VALUE:witness_id}} x=%u y=%u output=%p pre_output_words_agrb=%hu,%hu,%hu,%hu in_out=%u inside_threshold=%u outside_threshold=%u use_bg=%u invert=%u render_mode=%u interp_mode=%u power_bits=0x%08x grad_r_bits=0x%08x grad_g_bits=0x%08x grad_b_bits=0x%08x bg_r_bits=0x%08x bg_g_bits=0x%08x bg_b_bits=0x%08x\\n\",@$t6,@$t7,@$t6,@$t7,@$t1,poi(@$t1),poi(@$t1+2),poi(@$t1+4),poi(@$t1+6),dwo(@rbx+0x94),dwo(@rbx+0xb8),dwo(@rbx+0xbc),by(@rbx+0xc0),by(@rbx+0xc1),dwo(@rbx+0xc8),dwo(@rbx+0xcc),dwo(@rbx+0xd0),dwo(@rbx+0xa0),dwo(@rbx+0x9c),dwo(@rbx+0xa4),dwo(@rbx+0xb0),dwo(@rbx+0xac),dwo(@rbx+0xb4);gu;.printf \"OLMDG_LFS_RETURN_%u_%u run_id={{RUN_ID}} ae_pid={{AE_PID}} module_base={{MODULE_BASE}} aex_sha256={{AEX_SHA256}} project_bpc={{PROJECT_BPC}} renderer={{RENDERER}} case_id={{CASE_ID}} witness_id={{CASE_VALUE:witness_id}} x=%u y=%u output=%p post_output_words_agrb=%hu,%hu,%hu,%hu pf16_final_store_words_agrb=%hu,%hu,%hu,%hu\\n\",@$t6,@$t7,@$t6,@$t7,@$t1,poi(@$t1),poi(@$t1+2),poi(@$t1+4),poi(@$t1+6),poi(@$t1),poi(@$t1+2),poi(@$t1+4),poi(@$t1+6);r @$t2=@$t2+1;r @$t0=0;r @$t1=0;.if (@$t2==4) {.detach;q} .else {gc}};gc}"
bp {{ADDRESS:field}} ".if (@$t0==1) {.printf \"OLMDG_LFS_FIELD_%u_%u run_id={{RUN_ID}} ae_pid={{AE_PID}} module_base={{MODULE_BASE}} aex_sha256={{AEX_SHA256}} project_bpc={{PROJECT_BPC}} renderer={{RENDERER}} case_id={{CASE_ID}} witness_id={{CASE_VALUE:witness_id}} x=%u y=%u rcx=%p rcx_plus2_word=%hu field_words_agrb=%hu,%hu,%hu,%hu field_base=%p field_header=%p field_rowbytes=15360 field_pixel_size=8\\n\",@$t6,@$t7,@$t6,@$t7,@rcx,poi(@rcx+2),poi(@rcx),poi(@rcx+2),poi(@rcx+4),poi(@rcx+6),@r10+0x18,@r10)};gc"
bp {{ADDRESS:source}} ".if (@$t0==1) {.printf \"OLMDG_LFS_SOURCE_%u_%u run_id={{RUN_ID}} ae_pid={{AE_PID}} module_base={{MODULE_BASE}} aex_sha256={{AEX_SHA256}} project_bpc={{PROJECT_BPC}} renderer={{RENDERER}} case_id={{CASE_ID}} witness_id={{CASE_VALUE:witness_id}} x=%u y=%u rdx=%p source_words_agrb=%hu,%hu,%hu,%hu\\n\",@$t6,@$t7,@$t6,@$t7,@rdx,poi(@rdx),poi(@rdx+2),poi(@rdx+4),poi(@rdx+6))};gc"
.echo OLMDG_LFS_BREAKPOINTS_ARMED
g

+fn olm_trace_ucrt_call(kind: &str, left: u32, right: Option<u32>, result: u32) {
+    let Ok(path) = std::env::var("OLM_UCRT_CALL_TRACE") else { return };
+    use std::io::Write as _;
+    let Ok(mut output) = std::fs::OpenOptions::new().create(true).append(true).open(path) else { return };
+    match right {
+        None => { let _ = writeln!(output, "{kind},{left:08x},{result:08x}"); }
+        Some(value) => { let _ = writeln!(output, "{kind},{left:08x},{value:08x},{result:08x}"); }
+    }
+}

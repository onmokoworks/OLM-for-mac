+fn olm_native_ucrt_result(kind: &str, left: u32, right: Option<u32>) -> Option<u32> {
+    let path = std::env::var_os("OLM_NATIVE_UCRT_TABLE")?;
+    let text = std::fs::read_to_string(path).ok()?;
+    for line in text.lines() {
+        let fields = line.split_ascii_whitespace().collect::<Vec<_>>();
+        let matched = match (kind, right, fields.as_slice()) {
+            ("expf", None, ["e", argument, _]) => {
+                u32::from_str_radix(argument, 16).ok() == Some(left)
+            }
+            ("powf", Some(exponent), ["p", input, power, _]) => {
+                u32::from_str_radix(input, 16).ok() == Some(left)
+                    && u32::from_str_radix(power, 16).ok() == Some(exponent)
+            }
+            _ => false,
+        };
+        if matched {
+            return fields.last().and_then(|word| u32::from_str_radix(word, 16).ok());
+        }
+    }
+    None
+}
+
+fn olm_missing_native_ucrt_result(unicorn: &mut Unicorn<'_, GuestState>, name: &str) {
+    unicorn.get_data_mut().callback_error = Some(format!("missing OLM native UCRT {name} key"));
+    let _ = unicorn.emu_stop();
+}

.effmach amd64
.expr /s masm
sxi e06d7363
.logopen /t "{{TRACE_PATH}}"
.echo WITNESS_META {{RUN_ID}} {{AE_PID}} {{MODULE_BASE}} {{AEX_SHA256}} {{PROJECT_BPC}} {{RENDERER}} {{CASE_ID}}
r @$t0=0;r @$t1=0;r @$t6=0;r @$t7=0
bp {{ADDRESS:entry}} ".block {r @$t0=0;r @$t1=0;r @$t6=@edx;r @$t7=@r8;.if (dwo(@rbx+0x94)==3 && dwo(@rbx+0xb8)==158 && dwo(@rbx+0xbc)==13 && by(@rbx+0xc0)==1 && by(@rbx+0xc1)==1 && dwo(@rbx+0xc8)==1 && dwo(@rbx+0xcc)==4 && dwo(@rbx+0xd0)==0x40263bec && dwo(@rbx+0xa0)==0x3de0e0ff && dwo(@rbx+0x9c)==0 && dwo(@rbx+0xa4)==0x3f6eeeef && dwo(@rbx+0xb0)==0x3f800000 && dwo(@rbx+0xac)==0 && dwo(@rbx+0xb4)==0 && ((@edx==907 && @r8==222) || (@edx==395 && @r8==477) || (@edx==1589 && @r8==579) || (@edx==898 && @r8==670))) {r @$t0=1;r @$t1=poi(@rsp+0x28);.printf \"OLMDG_LFS_ENTRY_%u_%u run_id={{RUN_ID}} ae_pid={{AE_PID}} project_bpc={{PROJECT_BPC}} renderer={{RENDERER}} case_id={{CASE_ID}} witness_id={{CASE_VALUE:witness_id}} x=%u y=%u output=%p pre_output_words_agrb=%hu,%hu,%hu,%hu in_out=%u inside_threshold=%u outside_threshold=%u use_bg=%u invert=%u render_mode=%u interp_mode=%u power_bits=0x%08x\\n\",@$t6,@$t7,@$t6,@$t7,@$t1,poi(@$t1),poi(@$t1+2),poi(@$t1+4),poi(@$t1+6),dwo(@rbx+0x94),dwo(@rbx+0xb8),dwo(@rbx+0xbc),by(@rbx+0xc0),by(@rbx+0xc1),dwo(@rbx+0xc8),dwo(@rbx+0xcc),dwo(@rbx+0xd0);gu;.printf \"OLMDG_LFS_RETURN_%u_%u run_id={{RUN_ID}} ae_pid={{AE_PID}} project_bpc={{PROJECT_BPC}} renderer={{RENDERER}} case_id={{CASE_ID}} witness_id={{CASE_VALUE:witness_id}} x=%u y=%u output=%p post_output_words_agrb=%hu,%hu,%hu,%hu pf16_final_store_words_agrb=%hu,%hu,%hu,%hu\\n\",@$t6,@$t7,@$t6,@$t7,@$t1,poi(@$t1),poi(@$t1+2),poi(@$t1+4),poi(@$t1+6),poi(@$t1),poi(@$t1+2),poi(@$t1+4),poi(@$t1+6);r @$t0=0;r @$t1=0;gc;};gc}"
bp {{ADDRESS:field}} ".if (@$t0==1) {.printf \"OLMDG_LFS_FIELD_%u_%u run_id={{RUN_ID}} ae_pid={{AE_PID}} project_bpc={{PROJECT_BPC}} renderer={{RENDERER}} case_id={{CASE_ID}} witness_id={{CASE_VALUE:witness_id}} x=%u y=%u rcx=%p rcx_plus2_word=%hu field_words_agrb=%hu,%hu,%hu,%hu field_base=%p field_header=%p field_rowbytes=15360 field_pixel_size=8\\n\",@$t6,@$t7,@$t6,@$t7,@rcx,poi(@rcx+2),poi(@rcx),poi(@rcx+2),poi(@rcx+4),poi(@rcx+6),@r10+0x18,@r10)};gc"
bp {{ADDRESS:source}} ".if (@$t0==1) {.printf \"OLMDG_LFS_SOURCE_%u_%u run_id={{RUN_ID}} ae_pid={{AE_PID}} project_bpc={{PROJECT_BPC}} renderer={{RENDERER}} case_id={{CASE_ID}} witness_id={{CASE_VALUE:witness_id}} x=%u y=%u rdx=%p source_words_agrb=%hu,%hu,%hu,%hu\\n\",@$t6,@$t7,@$t6,@$t7,@rdx,poi(@rdx),poi(@rdx+2),poi(@rdx+4),poi(@rdx+6))};gc"
.echo OLMDG_LFS_BREAKPOINTS_ARMED
g

-		err = scan_world(pass_input, output, state, main_pix_fn);
+#ifndef OLM_REFERENCE_BUILD
+		// Classifiers only read the immutable input and their own virtual stack.
+		// Dispatchers blend into overlapping destination spans, so preserve their
+		// exact y/x/direction order. Bound precomputed storage to a 32-row band.
+		const size_t width = right > left ? size_t(right - left) : 0;
+		const size_t height = bottom > top ? size_t(bottom - top) : 0;
+		const uintptr_t source_begin = reinterpret_cast<uintptr_t>(pass_input->data);
+		const uintptr_t target_begin = reinterpret_cast<uintptr_t>(output->data);
+		const size_t source_bytes = size_t(pass_input->rowbytes) * size_t(pass_input->height);
+		const size_t target_bytes = size_t(output->rowbytes) * size_t(output->height);
+		const bool separate = source_begin <= target_begin
+		    ? target_begin - source_begin >= source_bytes
+		    : source_begin - target_begin >= target_bytes;
+		constexpr size_t band_rows = 32;
+		int32_t *classes = nullptr;
+		if (separate && width && height >= 8 && width * height >= 65536 &&
+		    (sizeof(PixelT) == sizeof(PF_Pixel8) || sizeof(PixelT) == sizeof(PF_Pixel16))) {
+			classes = static_cast<int32_t *>(malloc(width * band_rows * 4 * sizeof(int32_t)));
+		}
+		if (classes) {
+			constexpr uint32_t directions[] = {5, 3, 1, 7};
+			for (size_t band = 0; band < height; band += band_rows) {
+				const size_t rows = std::min(band_rows, height - band);
+				olm::parallel_rows(rows, 4, [&](size_t row) {
+					const A_long y = top + A_long(band + row);
+					for (A_long x = left; x < right; ++x) {
+						uintptr_t neigh[10];
+						if (sizeof(PixelT) == sizeof(PF_Pixel16))
+							NeighborExtract16(x, y, state, neigh);
+						else NeighborExtract8(x, y, state, neigh);
+						for (size_t d = 0; d < 4; ++d)
+							classes[(row * width + size_t(x - left)) * 4 + d] =
+							    sizeof(PixelT) == sizeof(PF_Pixel16)
+							    ? Classifier16(state, x, y, neigh, directions[d])
+							    : Classifier8(state, x, y, neigh, directions[d]);
+					}
+				});
+				for (size_t row = 0; row < rows; ++row) {
+					const A_long y = top + A_long(band + row);
+					for (A_long x = left; x < right; ++x) {
+						uintptr_t neigh[10];
+						if (sizeof(PixelT) == sizeof(PF_Pixel16))
+							NeighborExtract16(x, y, state, neigh);
+						else NeighborExtract8(x, y, state, neigh);
+						for (size_t d = 0; d < 4; ++d) {
+							const int32_t st = classes[(row * width + size_t(x - left)) * 4 + d];
+							if (sizeof(PixelT) == sizeof(PF_Pixel16))
+								DispatchDirection16(state, neigh, x, y, directions[d], st);
+							else DispatchDirection8(state, neigh, x, y, directions[d], st);
+						}
+					}
+				}
+			}
+			free(classes);
+		} else
+#endif
+		{
+			err = scan_world(pass_input, output, state, main_pix_fn);
+		}
 	}
 
 	free(key_world_data);

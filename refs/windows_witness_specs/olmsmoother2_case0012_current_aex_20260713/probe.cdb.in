bp {{ADDRESS:e3a0}} ".if (@$t0==1 && @$t3==0) {r @$t3=1;.printf \"S2_E3A0 run_id={{RUN_ID}} ae_pid={{AE_PID}} module_base={{MODULE_BASE}} aex_sha256={{AEX_SHA256}} project_bpc={{PROJECT_BPC}} renderer={{RENDERER}} case_id={{CASE_ID}} witness_id={{CASE_VALUE:witness_id}} stage=e3a0 hook_rva=e3a0 append=%u source_xy=%u,%u weight=%g\\n\",@r8d,@r9d,@r10d,@xmm0} ;gc"
bp {{ADDRESS:c280}} ".if (@$t0==1 && @$t4==0) {r @$t4=1;.printf \"S2_C280 run_id={{RUN_ID}} ae_pid={{AE_PID}} module_base={{MODULE_BASE}} aex_sha256={{AEX_SHA256}} project_bpc={{PROJECT_BPC}} renderer={{RENDERER}} case_id={{CASE_ID}} witness_id={{CASE_VALUE:witness_id}} stage=c280 hook_rva=c280 polygon_count=%u config_pointer=%p config_pointer_arithmetic=rax+0x20_scale_fixed_words config_raw_bytes=%02x,%02x,%02x,%02x,%02x,%02x,%02x,%02x scale_fixed=%u,%u\\n\",@eax,@rax,by(@rax+0x20),by(@rax+0x21),by(@rax+0x22),by(@rax+0x23),by(@rax+0x24),by(@rax+0x25),by(@rax+0x26),by(@rax+0x27),dwo(@rax+0x20),dwo(@rax+0x24)} ;gc"

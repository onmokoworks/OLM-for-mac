bp {{ADDRESS:pf_store}} ".if (@$t0==1 && @r12d==169 && @r13d==494) {r @$t1=poi(@rsi);.writemem \"{{TRACE_PATH}}.writer_pf_argb8.bin\" @rsi @rsi+3;.printf \"DBR_PF_STORE run_id={{RUN_ID}} ae_pid={{AE_PID}} module_base={{MODULE_BASE}} aex_sha256={{AEX_SHA256}} project_bpc={{PROJECT_BPC}} renderer={{RENDERER}} case_id={{CASE_ID}} witness_id={{CASE_VALUE:witness_id}} stage=pf_store hook_rva=6b30 x=494 y=169 store_addr=%p writer_addr=%p pf_argb_bytes=%u,%u,%u,%u typed_argb8=1 same_run_key=writer-pf-494-169\\n\",@rsi,@rdi,by(@rsi),by(@rsi+1),by(@rsi+2),by(@rsi+3);.echo DBR_WRITER_ENTRY_COMPLETE;.detach;q};gc"

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://olm.invalid/windows-witness/witness-spec.schema.json",
  "title": "Windows AE/CDB witness specification M0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "request_id", "run_id_prefix", "plugin", "host",
    "project", "renderer", "request_assets", "cases", "validation",
    "return_bundle"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "description": {"type": "string"},
    "request_id": {"$ref": "#/$defs/id"},
    "run_id_prefix": {"$ref": "#/$defs/id"},
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "module_filename", "aex_sha256", "default_aex_path"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "module_filename": {"type": "string", "pattern": "^[^/\\\\]+\\.aex$"},
        "aex_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "default_aex_path": {"type": "string", "minLength": 1},
        "cache_rescan": {"type": "boolean"}
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["afterfx_path"],
      "properties": {
        "afterfx_path": {"type": "string", "minLength": 1},
        "cdb_path": {"type": "string", "minLength": 1}
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bits_per_channel", "renderer"],
      "properties": {
        "bits_per_channel": {"enum": [8, 16, 32]},
        "renderer": {"const": "Software"},
        "environment": {
          "type": "object",
          "propertyNames": {"pattern": "^[A-Z][A-Z0-9_]*$"},
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "renderer": {"$ref": "#/$defs/sourceObject"},
    "request_assets": {"$ref": "#/$defs/sourceObject"},
    "transport": {"$ref": "#/$defs/transport"},
    "cdb": {
      "type": "object",
      "additionalProperties": false,
      "required": ["armed_marker", "arm_timeout_seconds", "capture_timeout_seconds"],
      "properties": {
        "armed_marker": {"type": "string", "minLength": 1},
        "arm_timeout_seconds": {"type": "integer", "minimum": 1},
        "capture_timeout_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_fields", "events"],
      "properties": {
        "identity_fields": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"},
          "allOf": [
            {"contains": {"const": "run_id"}}, {"contains": {"const": "ae_pid"}},
            {"contains": {"const": "module_base"}}, {"contains": {"const": "aex_sha256"}},
            {"contains": {"const": "project_bpc"}}, {"contains": {"const": "renderer"}},
            {"contains": {"const": "case_id"}}
          ]
        },
        "events": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/event"}}
      }
    },
    "return_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["json_name", "zip_name"],
      "properties": {
        "json_name": {"type": "string", "pattern": "^[^/\\\\]+\\.json$"},
        "zip_name": {"type": "string", "pattern": "^[^/\\\\]+\\.zip$"},
        "include_logs": {"type": "array", "items": {"$ref": "#/$defs/relativePath"}}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "relativePath": {"type": "string", "minLength": 1, "not": {"pattern": "(^[/\\\\])|(^|[/\\\\])\\.\\.([/\\\\]|$)"}},
    "sourceObject": {
      "type": "object", "additionalProperties": false, "required": ["source"],
      "properties": {"source": {"$ref": "#/$defs/relativePath"}}
    },
    "export": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "archive_path", "required"],
      "properties": {
        "source": {"$ref": "#/$defs/relativePath"},
        "archive_path": {"$ref": "#/$defs/relativePath"},
        "required": {"type": "boolean"}
      }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "cdb_template": {"$ref": "#/$defs/relativePath"},
        "template_values": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}},
        "addresses": {"type": "object", "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"type": "string", "pattern": "^0x[0-9a-fA-F]+$"}},
        "exports": {"type": "array", "items": {"$ref": "#/$defs/export"}}
      }
    },
    "transport": {
      "oneOf": [
        {"$ref": "#/$defs/cdbTransport"},
        {"$ref": "#/$defs/collectorTransport"}
      ]
    },
    "cdbTransport": {
      "type": "object", "additionalProperties": false,
      "required": ["kind"],
      "properties": {"kind": {"const": "cdb"}}
    },
    "collectorTransport": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "injector_path", "collector_dll", "config_template", "required_outputs"],
      "properties": {
        "kind": {"const": "in_process_collector"},
        "injector_path": {"$ref": "#/$defs/relativePath"},
        "collector_dll": {"$ref": "#/$defs/relativePath"},
        "config_template": {"$ref": "#/$defs/relativePath"},
        "required_outputs": {
          "type": "array", "minItems": 2, "uniqueItems": true,
          "items": {"$ref": "#/$defs/relativePath"},
          "allOf": [
            {"contains": {"const": "collector_trace.txt"}},
            {"contains": {"const": "collector_status.json"}}
          ]
        },
        "arm_timeout_seconds": {"type": "integer", "minimum": 1},
        "capture_timeout_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "constraint": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {"equals": {"type": ["string", "number", "boolean"]}, "pattern": {"type": "string"}}
    },
    "fieldRelation": {
      "type": "object", "additionalProperties": false,
      "required": [
        "type", "address_field", "base_field", "row_field", "row_origin_field",
        "column_field", "column_origin_field", "stride_field", "element_size", "channel_offset"
      ],
      "properties": {
        "type": {"const": "address_arithmetic"},
        "address_field": {"$ref": "#/$defs/id"},
        "base_field": {"$ref": "#/$defs/id"},
        "row_field": {"$ref": "#/$defs/id"},
        "row_origin_field": {"$ref": "#/$defs/id"},
        "column_field": {"$ref": "#/$defs/id"},
        "column_origin_field": {"$ref": "#/$defs/id"},
        "stride_field": {"$ref": "#/$defs/id"},
        "element_size": {"type": "integer", "minimum": 1},
        "channel_offset": {"type": "integer", "minimum": 0}
      }
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "prefix", "cardinality", "required_fields"],
      "properties": {
        "name": {"$ref": "#/$defs/id"},
        "prefix": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "cardinality": {
          "type": "object", "additionalProperties": false, "required": ["scope", "min", "max"],
          "properties": {"scope": {"enum": ["per_case", "global"]}, "min": {"type": "integer", "minimum": 0}, "max": {"type": "integer", "minimum": 0}}
        },
        "required_fields": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "field_constraints": {"type": "object", "additionalProperties": {"$ref": "#/$defs/constraint"}},
        "field_relations": {"type": "array", "items": {"$ref": "#/$defs/fieldRelation"}}
      }
    }
  }
}
